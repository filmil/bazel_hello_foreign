module(
    name = "integration",
    version = "0.0.0",
)

bazel_dep(name = "rules_foreign_cc", version = "0.16.0")
bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")
toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(toolchains, "zig_sdk")
bazel_dep(name = "gcc_toolchain", version = "0.13.0")
bazel_dep(name = "rules_shell", version = "0.6.1")


bazel_dep(name = "hello_foreign", version = "0.0.0", repo_name = "hello")
local_path_override(
    module_name = "hello_foreign",
    path = "../",
)
