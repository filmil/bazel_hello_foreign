    deps = [":libhello"],
    copts = [
        "-DLOCALEDIR=\\\"/usr/local/share/locale\\\"",
        "-DHAVE_CONFIG_H",
        "-Iexternal/+_repo_rules+src",
        "-Iexternal/+_repo_rules+src/lib",
        "-Wno-implicit-function-declaration",
        "-Wno-int-conversion",
    ],
    visibility = ["//visibility:public"],
)
