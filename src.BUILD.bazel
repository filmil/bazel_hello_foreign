        "lib/stripslash.c",
        "lib/exitfail.c",
        "lib/fd-hook.c",
        "lib/getprogname.c",
        "lib/hard-locale.c",
        "lib/localcharset.c",
        "lib/malloca.c",
        "lib/mbchar.c",
        "lib/mbiter.c",
        "lib/mbslen.c",
        "lib/mbsstr.c",
        "lib/mbuiter.c",
        "lib/progname.c",
        "lib/propername.c",
        "lib/quotearg.c",
        "lib/setlocale_null.c",
        "lib/stat-time.c",
